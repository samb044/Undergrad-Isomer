import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
import matplotlib.pyplot as plt

# -----------------------------
# 1. CNN model
# -----------------------------
class CoincidenceCNN(nn.Module):
    def __init__(self):
        super().__init__()

        self.model = nn.Sequential(
            nn.Conv2d(1, 8, kernel_size=3, padding=1),
            nn.ReLU(),

            nn.Conv2d(8, 16, kernel_size=3, padding=1),
            nn.ReLU(),

            nn.Conv2d(16, 1, kernel_size=3, padding=1),
            nn.Sigmoid()
        )

    def forward(self, x):
        return self.model(x)


# -----------------------------
# 2. Make one training example
# -----------------------------
def make_training_example():
    coinc_mat, coinc_mat_no_scatter, transition_mat, transition_scheme = CreateSample(
        sim_size=0,
        draw_background=True
    )

    X = coinc_mat.astype(np.float32)
    y = (coinc_mat_no_scatter > 0).astype(np.float32)

    # normalize input
    X = X / (X.max() + 1e-8)

    # shape: [batch, channel, height, width]
    X = torch.tensor(X).unsqueeze(0).unsqueeze(0)
    y = torch.tensor(y).unsqueeze(0).unsqueeze(0)

    return X, y


# -----------------------------
# 3. Train CNN
# -----------------------------
def train_cnn(num_epochs=20, examples_per_epoch=10):
    model = CoincidenceCNN()

    criterion = nn.BCELoss()
    optimizer = optim.Adam(model.parameters(), lr=0.001)

    loss_history = []

    for epoch in range(num_epochs):
        epoch_loss = 0

        for _ in range(examples_per_epoch):
            X, y = make_training_example()

            # CNN prediction
            prediction = model(X)

            # BCE Loss
            loss = criterion(prediction, y)

            # Metrics
            pred_binary = (prediction > 0.5).float()

            TP = ((pred_binary == 1) & (y == 1)).sum()
            FP = ((pred_binary == 1) & (y == 0)).sum()
            FN = ((pred_binary == 0) & (y == 1)).sum()

            precision = TP / (TP + FP + 1e-8)
            recall = TP / (TP + FN + 1e-8)
            f1 = 2 * precision * recall / (precision + recall + 1e-8)

            # Backpropagation
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()

            epoch_loss += loss.item()

        avg_loss = epoch_loss / examples_per_epoch
        loss_history.append(avg_loss)

        print(
            f"Epoch {epoch + 1}/{num_epochs}, "
            f"Loss={avg_loss:.6f}, "
            f"Precision={precision.item():.4f}, "
            f"Recall={recall.item():.4f}, "
            f"F1={f1.item():.4f}"
        )

        print(f"Epoch {epoch + 1}/{num_epochs}, Loss: {avg_loss:.6f}")

    return model, loss_history


# -----------------------------
# 4. Run training
# -----------------------------
model, loss_history = train_cnn(
    num_epochs=20,
    examples_per_epoch=10
)


# -----------------------------
# 5. Loss graph
# -----------------------------
plt.figure(figsize=(8, 5))
plt.plot(range(1, len(loss_history) + 1), loss_history, marker="o")
plt.xlabel("Epoch")
plt.ylabel("Binary Cross Entropy Loss")
plt.title("CNN Training Loss")
plt.grid(True)
plt.savefig("cnn_training_loss.png", dpi=300)
plt.show()
