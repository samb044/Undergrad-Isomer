def visualize_true_vs_predicted(bands, predicted_labels, index_energy):
    fig, ax = plt.subplots(1, 2, figsize=(18, 8))

    ax[0].set_title("True Bands")
    for b_idx, band in enumerate(bands):
        y = [b_idx] * len(band)
        ax[0].scatter(band, y, s=80)
        for g in band:
            ax[0].text(g, b_idx + 0.05, f"{int(g)} keV", fontsize=8)
    ax[0].grid(True)

    ax[1].set_title("Predicted Clusters")
    for p_idx in np.unique(predicted_labels):
        group_indices = np.where(predicted_labels == p_idx)[0]
        energies = [index_energy[n] for n in group_indices]
        y = [p_idx] * len(energies)
        ax[1].scatter(energies, y, s=80)
        for e in energies:
            ax[1].text(e, p_idx + 0.05, f"{int(e)} keV", fontsize=8)
    ax[1].grid(True)

    plt.tight_layout()
    plt.show()


def visualize_matrix_with_peaks(coinc, energy_axis_keV, peaks_idx):
    plt.figure(figsize=(6, 5))
    plt.imshow(
        coinc,
        origin="lower",
        cmap="inferno",
        extent=[
            energy_axis_keV[0], energy_axis_keV[-1],
            energy_axis_keV[0], energy_axis_keV[-1]
        ]
    )
    plt.colorbar(label="Counts")

    # Plot peak markers
    if peaks_idx is not None and len(peaks_idx) > 0:
        xs = energy_axis_keV[peaks_idx]
        ys = energy_axis_keV[peaks_idx]
        plt.scatter(xs, ys, s=10, c="cyan", label="Peaks")

    plt.xlabel("Energy (keV)")
    plt.ylabel("Energy (keV)")
    plt.legend()
    plt.tight_layout()
    plt.show()

