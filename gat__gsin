# =========================
# 1. PHYSICS-INSPIRED CASCADE GENERATOR
# =========================

def generate_rotational_band(J_min=0, J_max=10, A=10.0, jitter_keV=5.0):
    Js = np.arange(J_min, J_max + 1)
    E_levels = A * Js * (Js + 1)
    E_levels = E_levels - E_levels.min()
    E_levels = E_levels + np.random.normal(0.0, jitter_keV, size=E_levels.shape)
    E_levels = np.clip(E_levels, 0.0, None)
    gammas = []
    for i in range(len(E_levels) - 1, 0, -1):
        Eg = E_levels[i] - E_levels[i - 1]
        if Eg > 0:
            gammas.append(Eg)
    return np.array(gammas, dtype=np.float32)


def generate_vibrational_band(num_levels=5, base_E=500.0, spacing_keV=200.0, jitter_keV=10.0):
    E_levels = base_E + spacing_keV * np.arange(num_levels)
    E_levels = E_levels + np.random.normal(0.0, jitter_keV, size=E_levels.shape)
    gammas = []
    for i in range(len(E_levels) - 1, 0, -1):
        Eg = E_levels[i] - E_levels[i - 1]
        if Eg > 0:
            gammas.append(Eg)
    return np.array(gammas, dtype=np.float32)


def generate_isomeric_state(E_iso_keV=2500.0, lifetime_scale=5.0):
    Eg = E_iso_keV - np.random.uniform(200.0, 600.0)
    return np.array([Eg], dtype=np.float32)


def generate_bands_cascade(num_bands=8, max_gamma_keV=1500.0):
    bands = []
    for b in range(num_bands):
        kind = np.random.choice(["rot", "vib", "iso"], p=[0.6, 0.3, 0.1])
        if kind == "rot":
            J_max = np.random.randint(6, 12)
            A = np.random.uniform(5.0, 15.0)
            band = generate_rotational_band(J_min=0, J_max=J_max, A=A)
        elif kind == "vib":
            nlev = np.random.randint(3, 7)
            base_E = np.random.uniform(300.0, 800.0)
            spacing = np.random.uniform(150.0, 300.0)
            band = generate_vibrational_band(num_levels=nlev, base_E=base_E, spacing_keV=spacing)
        else:
            band = generate_isomeric_state(E_iso_keV=np.random.uniform(1200.0, 2000.0))

        band = band[band > 0]
        band = band[band < max_gamma_keV]
        if len(band) >= 2:
            bands.append(band.astype(np.float32))

    return bands


# =========================
# 2. COINCIDENCE MATRIX BUILDER (REALISTIC HPGe RESOLUTION)
# =========================

def hpge_fwhm_keV(E_keV, a=0.8, b=0.001, c=1.0):
    return a * np.sqrt(np.maximum(E_keV, 0.0)) + b * E_keV + c


def add_gaussian_peak(matrix, energy_axis_keV, E_gamma, counts):
    sigma_keV = hpge_fwhm_keV(E_gamma) / 2.355
    sigma_bins = sigma_keV / (energy_axis_keV[1] - energy_axis_keV[0])
    centers = E_gamma / (energy_axis_keV[1] - energy_axis_keV[0])
    x = np.arange(len(energy_axis_keV))
    profile = np.exp(-0.5 * ((x - centers) / (sigma_bins + 1e-6)) ** 2)
    profile = profile / (profile.sum() + 1e-8)
    return matrix + counts * profile


def bands_to_coincidence_matrix_cascade(bands,
                                        arr_size=512,
                                        keV_max=3000.0,
                                        num_events=5000,
                                        noise_level=0.02):
    import random as pyrandom

    keV_per_bin = keV_max / arr_size
    energy_axis_keV = np.arange(arr_size, dtype=np.float32) * keV_per_bin
    coinc = np.zeros((arr_size, arr_size), dtype=np.float32)

    for _ in range(num_events):
        band = pyrandom.choice(bands)

        if len(band) < 2:
            continue

        max_mult = min(len(band), 6)
        if max_mult < 2:
            continue

        mult = np.random.randint(2, max_mult + 1)
        idxs = np.random.choice(len(band), size=mult, replace=False)
        cascade = band[idxs]
        cascade.sort()

        for i in range(len(cascade)):
            for j in range(i + 1, len(cascade)):
                Ei = cascade[i]
                Ej = cascade[j]

                coinc = add_gaussian_peak(coinc, energy_axis_keV, Ei, counts=np.random.uniform(5.0, 20.0))
                coinc = add_gaussian_peak(coinc, energy_axis_keV, Ej, counts=np.random.uniform(5.0, 20.0))

                bi = int(Ei / keV_per_bin)
                bj = int(Ej / keV_per_bin)
                if 0 <= bi < arr_size and 0 <= bj < arr_size:
                    coinc[bi, bj] += np.random.uniform(5.0, 20.0)
                    coinc[bj, bi] += np.random.uniform(5.0, 20.0)

    noise = np.random.exponential(scale=noise_level, size=coinc.shape).astype(np.float32)
    coinc = coinc + noise

    return coinc, energy_axis_keV


# =========================
# 3. PEAK EXTRACTOR
# =========================

def extract_peaks_from_matrix(coinc, energy_axis_keV, min_intensity=5.0):
    proj = coinc.sum(axis=0)
    arr_size = len(proj)

    peaks_idx = []
    intensity = []
    index_energy = []

    for i in range(1, arr_size - 1):
        if proj[i] > min_intensity and proj[i] > proj[i - 1] and proj[i] > proj[i + 1]:
            peaks_idx.append(i)
            intensity.append(proj[i])
            index_energy.append(energy_axis_keV[i])

    peaks_idx = np.array(peaks_idx, dtype=np.int32)
    intensity = np.array(intensity, dtype=np.float32)
    index_energy = np.array(index_energy, dtype=np.float32)

    return peaks_idx, index_energy, intensity


# =========================
# 4. GRAPH BUILDER
# =========================

def build_edges_vectorized(index_energy, delta_E=50.0):
    E = index_energy.astype(np.float32)
    diff = np.abs(E[:, None] - E[None, :])
    edge_mask = (diff > 0) & (diff < delta_E)
    src, dst = np.where(edge_mask)
    edges = np.stack([src, dst], axis=0)
    return edges, diff


def build_node_features_vectorized(index_energy, intensity, edges, coinc, energy_axis_keV):
    E = index_energy.astype(np.float32)
    I = intensity.astype(np.float32)
    N = E.shape[0]

    E_norm = (E - E.min()) / (E.max() - E.min() + 1e-8)

    src, dst = edges
    deg = np.zeros(N, dtype=np.float32)
    np.add.at(deg, src, 1.0)
    np.add.at(deg, dst, 1.0)

    I_norm = I / (I.max() + 1e-8)

    bin_idx = np.searchsorted(energy_axis_keV, E)
    bin_idx = np.clip(bin_idx, 0, coinc.shape[0] - 1)

    coinc_strength = coinc[:, bin_idx].sum(axis=0)
    coinc_strength = coinc_strength / (coinc_strength.max() + 1e-8)

    density = np.sum(np.abs(E[:, None] - E[None, :]) < 20.0, axis=1).astype(np.float32)

    pos_sin = np.sin(2.0 * np.pi * E_norm).astype(np.float32)
    pos_cos = np.cos(2.0 * np.pi * E_norm).astype(np.float32)

    features_node = np.stack([
        E_norm,
        deg,
        I_norm,
        coinc_strength,
        density,
        pos_sin,
        pos_cos
    ], axis=1)

    return features_node


def build_graph_from_matrix_optimized(coinc, energy_axis_keV,
                                      bands, delta_E=50.0, k=8, normalize_features=True):
    peaks_idx, index_energy, intensity = extract_peaks_from_matrix(
        coinc, energy_axis_keV, min_intensity=5.0
    )

    if len(index_energy) == 0:
        raise ValueError("No peaks detected.")

    edges, diff = build_edges_vectorized(index_energy, delta_E=delta_E)
    src, dst = edges

    deltaE = diff[src, dst]
    edge_weights = np.exp(-deltaE / delta_E).astype(np.float32)

    src_sym = np.concatenate([src, dst], axis=0)
    dst_sym = np.concatenate([dst, src], axis=0)
    edge_weights_sym = np.concatenate([edge_weights, edge_weights], axis=0)
    edges_sym = np.array([src_sym, dst_sym])

    def sparsify_edges(edges, edge_weights, k):
        src, dst = edges
        N = int(src.max()) + 1

        new_src, new_dst, new_w = [], [], []

        for node in range(N):
            mask = (src == node)
            idx = np.where(mask)[0]

            if len(idx) > k:
                top = idx[np.argsort(edge_weights[idx])[-k:]]
            else:
                top = idx

            for t in top:
                new_src.append(src[t])
                new_dst.append(dst[t])
                new_w.append(edge_weights[t])

        return np.array([new_src, new_dst]), np.array(new_w, dtype=np.float32)

    edges_sparse, edge_weights_sparse = sparsify_edges(edges_sym, edge_weights_sym, k)

    features_node = build_node_features_vectorized(
        index_energy, intensity, edges_sparse, coinc, energy_axis_keV
    )

    if normalize_features:
        mean = features_node.mean(axis=0, keepdims=True)
        std = features_node.std(axis=0, keepdims=True) + 1e-8
        features_node = (features_node - mean) / std

    return (
        peaks_idx,
        intensity,
        peaks_idx,
        index_energy,
        edges_sparse,
        features_node,
        index_energy,
        edge_weights_sparse
    )


# =========================
# 5. TRUE LABELS
# =========================

def build_true_labels(index_energy, bands, atol=20.0):
    labels = -np.ones(len(index_energy), dtype=np.int32)
    for b_idx, band in enumerate(bands):
        for Eg in band:
            diff = np.abs(index_energy - Eg)
            idx = np.where(diff < atol)[0]
            labels[idx] = b_idx
    return labels


# =========================
# 6. BAND-FOCUSED GRAPH
# =========================

def build_band_focused_graph(index_energy, features_node, edges, edge_weights,
                             labels, max_band_keV=1600.0):
    energy_mask = index_energy <= max_band_keV
    label_mask = labels >= 0
    node_mask = energy_mask & label_mask

    new_index = -np.ones_like(index_energy, dtype=np.int32)
    new_index[node_mask] = np.arange(np.sum(node_mask))

    src, dst = edges
    keep_edges = node_mask[src] & node_mask[dst]

    src_new = new_index[src[keep_edges]]
    dst_new = new_index[dst[keep_edges]]
    edges_new = np.array([src_new, dst_new])

    return (
        index_energy[node_mask],
        features_node[node_mask],
        edges_new,
        edge_weights[keep_edges],
        labels[node_mask]
    )


# =========================
# 7. GATv2 + CLASSIFIER
# =========================

def init_gat_params_single(key, in_dim, hidden_dim=32, num_heads=4):
    k_w, k_att, k_ln = random.split(key, 3)

    W_in = random.normal(k_w, (num_heads, in_dim, hidden_dim)) * 0.1
    W_att = random.normal(k_att, (num_heads, 2 * hidden_dim, 1)) * 0.1

    gamma = jnp.ones((hidden_dim * num_heads,))
    beta = jnp.zeros((hidden_dim * num_heads,))

    return {"W_in": W_in, "W_att": W_att, "gamma": gamma, "beta": beta}


def init_gat_params_seven_layer(key, in_dim, hidden_dim=32, out_dim=32, num_heads=4):
    keys = random.split(key, 8)

    layer1 = init_gat_params_single(keys[0], in_dim, hidden_dim, num_heads)
    layer2 = init_gat_params_single(keys[1], hidden_dim * num_heads, hidden_dim, num_heads)
    layer3 = init_gat_params_single(keys[2], hidden_dim * num_heads, hidden_dim, num_heads)
    layer4 = init_gat_params_single(keys[3], hidden_dim * num_heads, hidden_dim, num_heads)
    layer5 = init_gat_params_single(keys[4], hidden_dim * num_heads, hidden_dim, num_heads)
    layer6 = init_gat_params_single(keys[5], hidden_dim * num_heads, hidden_dim, num_heads)
    layer7 = init_gat_params_single(keys[6], hidden_dim * num_heads, hidden_dim, num_heads)

    proj_out = random.normal(keys[7], (hidden_dim * num_heads, out_dim)) * 0.1

    return {
        "layer1": layer1,
        "layer2": layer2,
        "layer3": layer3,
        "layer4": layer4,
        "layer5": layer5,
        "layer6": layer6,
        "layer7": layer7,
        "proj_out": proj_out
    }


def layer_norm(x, gamma, beta, eps=1e-5):
    mean = jnp.mean(x, axis=-1, keepdims=True)
    var = jnp.mean((x - mean) ** 2, axis=-1, keepdims=True)
    x_hat = (x - mean) / jnp.sqrt(var + eps)
    return gamma * x_hat + beta


def encode_gat_single(params, features, edges, energy_list, edge_weights, key, dropout_rate=0.1):
    src, dst = edges
    x = features

    W_in = params["W_in"]
    W_att = params["W_att"]
    gamma = params["gamma"]
    beta = params["beta"]

    num_heads, _, hidden_dim = W_in.shape
    N = x.shape[0]

    h = jnp.einsum("nf,hfg->nhg", x, W_in)

    h_src = h[src]
    h_dst = h[dst]
    h_cat = jnp.concatenate([h_src, h_dst], axis=-1)

    att_logits = jnp.einsum("ehg,hg1->eh", h_cat, W_att)

    ew = jnp.array(edge_weights).reshape(-1, 1)
    att_logits = jnp.clip(att_logits * ew, -10.0, 10.0)

    def normalize_per_head(h_idx):
        logits_h = att_logits[:, h_idx]
        max_per_dst = jnp.zeros((N,)) - 1e9
        max_per_dst = max_per_dst.at[dst].max(logits_h)
        exp = jnp.exp(logits_h - max_per_dst[dst])
        sum_per_dst = jnp.zeros((N,))  
        sum_per_dst = sum_per_dst.at[dst].add(exp)
        return exp / (sum_per_dst[dst] + 1e-8)

    att_weights = jnp.stack(
        [normalize_per_head(h_idx) for h_idx in range(num_heads)],
        axis=-1
    )

    agg = jnp.zeros((N, num_heads, hidden_dim))
    agg = agg.at[dst].add(h_src * att_weights[:, :, None])

    agg_cat = agg.reshape(N, num_heads * hidden_dim)

    x_proj = jnp.einsum("nf,hfg->nhg", x, W_in).reshape(N, num_heads * hidden_dim)
    h_out = layer_norm(agg_cat + x_proj, gamma, beta)

    keep_prob = 1.0 - dropout_rate
    key, k_drop = random.split(key)
    mask = random.bernoulli(k_drop, p=keep_prob, shape=h_out.shape)
    h_out = h_out * mask / keep_prob

    return h_out


def encode_gat_seven_layer(params, features, edges, energy_list, edge_weights, key):
    keys = random.split(key, 7)

    h1 = encode_gat_single(params["layer1"], features, edges, energy_list, edge_weights, keys[0])
    h2 = encode_gat_single(params["layer2"], h1, edges, energy_list, edge_weights, keys[1])
    h3 = encode_gat_single(params["layer3"], h2, edges, energy_list, edge_weights, keys[2])
    h4 = encode_gat_single(params["layer4"], h3, edges, energy_list, edge_weights, keys[3])
    h5 = encode_gat_single(params["layer5"], h4, edges, energy_list, edge_weights, keys[4])
    h6 = encode_gat_single(params["layer6"], h5, edges, energy_list, edge_weights, keys[5])
    h7 = encode_gat_single(params["layer7"], h6, edges, energy_list, edge_weights, keys[6])

    return jnp.dot(h7, params["proj_out"])


def init_classifier_params(key, embed_dim, num_bands):
    k1, k2 = random.split(key)
    W = random.normal(k1, (embed_dim, num_bands)) * 0.1
    b = random.normal(k2, (num_bands,)) * 0.1
    return {"W_cls": W, "b_cls": b}


def band_classifier_head(cls_params, embed):
    W = cls_params["W_cls"]
    b = cls_params["b_cls"]
    logits = jnp.dot(embed, W) + b
    return logits


def supervised_band_loss(logits, labels):
    mask = labels >= 0
    logits = logits[mask]
    labels = labels[mask]
    return optax.softmax_cross_entropy_with_integer_labels(logits, labels).mean()


def contrastive_loss(embed, labels):
    embed = embed / (jnp.linalg.norm(embed, axis=-1, keepdims=True) + 1e-8)
    sim = jnp.dot(embed, embed.T) / 0.2

    pos_mask = (labels[:, None] == labels[None, :]).astype(jnp.float32)
    neg_mask = (labels[:, None] != labels[None, :]).astype(jnp.float32)

    exp_sim = jnp.exp(sim) * neg_mask
    denom = jnp.sum(exp_sim, axis=-1) + 1e-8

    pos_sim = jnp.exp(sim) * pos_mask
    num = jnp.sum(pos_sim, axis=-1) + 1e-8

    loss = -jnp.log(num / denom)
    return jnp.mean(loss)


def prototype_loss(embed, labels):
    num_bands = int(jnp.max(labels)) + 1

    def proto(b):
        mask = (labels == b).astype(jnp.float32)
        count = jnp.sum(mask)
        mean = jnp.sum(embed * mask[:, None], axis=0) / jnp.maximum(count, 1.0)
        return mean

    prototypes = jax.vmap(proto)(jnp.arange(num_bands))
    proto_for_points = prototypes[labels]
    return jnp.mean(jnp.linalg.norm(embed - proto_for_points, axis=-1))


def train_gat_seven_layer_labeled(features_node, edges, labels, energy_list, edge_weights,
                                  epochs=320, lr=3e-4):

    key = random.PRNGKey(0)

    features_j = jnp.array(features_node)
    edges_j = tuple(jax.lax.stop_gradient(jnp.array(e)) for e in edges)
    labels_j = jax.lax.stop_gradient(jnp.array(labels))
    energy_j = jax.lax.stop_gradient(jnp.array(energy_list))
    edge_w_j = jax.lax.stop_gradient(jnp.array(edge_weights))

    params_gat = init_gat_params_seven_layer(key, features_j.shape[-1])
    params_cls = init_classifier_params(key, embed_dim=32, num_bands=int(labels_j.max()) + 1)

    optimizer = optax.adamw(lr, weight_decay=1e-4)
    opt_state = optimizer.init((params_gat, params_cls))

    def total_loss(params_gat, params_cls, key):
        embed = encode_gat_seven_layer(params_gat, features_j, edges_j,
                                       energy_j, edge_w_j, key)

        mask = labels_j >= 0
        embed_l = embed[mask]
        labels_l = labels_j[mask]

        loss_c = contrastive_loss(embed_l, labels_l)
        loss_p = prototype_loss(embed_l, labels_l)

        logits = band_classifier_head(params_cls, embed)
        loss_sup = supervised_band_loss(logits, labels_j)

        loss = 0.4 * loss_c + 0.3 * loss_p + 0.3 * loss_sup
        return jnp.nan_to_num(loss), (embed, logits)

    def step(params_gat, params_cls, opt_state, key):
        (loss, (embed, logits)), grads = jax.value_and_grad(
            lambda pg, pc: total_loss(pg, pc, key),
            argnums=(0, 1),
            has_aux=True
        )(params_gat, params_cls)

        grads_gat, grads_cls = grads

        grads_gat = jax.tree_util.tree_map(
            lambda g: jnp.clip(jnp.nan_to_num(g), -0.5, 0.5),
            grads_gat
        )
        grads_cls = jax.tree_util.tree_map(
            lambda g: jnp.clip(jnp.nan_to_num(g), -0.5, 0.5),
            grads_cls
        )

        updates, opt_state = optimizer.update((grads_gat, grads_cls), opt_state,
                                              (params_gat, params_cls))
        params_gat = optax.apply_updates(params_gat, updates[0])
        params_cls = optax.apply_updates(params_cls, updates[1])

        return params_gat, params_cls, opt_state, jnp.nan_to_num(loss), embed, logits

    for epoch in range(0, epochs + 1, 20):
        key, k_step = random.split(key)
        params_gat, params_cls, opt_state, loss, embed, logits = step(
            params_gat, params_cls, opt_state, k_step
        )
        print(f"epoch {epoch}, loss {float(loss):.4f}")

    key, k_final = random.split(key)
    _, (embed, logits) = total_loss(params_gat, params_cls, k_final)

    return params_gat, params_cls, embed, logits


# =========================
# 8. CLUSTERING + EVALUATION + VISUALIZATION
# =========================

def cluster_embeddings(embed, index_energy, num_clusters=None):
    if num_clusters is None:
        num_clusters = 8
    kmeans = KMeans(n_clusters=num_clusters, n_init=10)
    labels_pred = kmeans.fit_predict(np.array(embed))
    return labels_pred


def evaluate_band_reconstruction(labels_true, labels_pred):
    mask = labels_true >= 0
    lt = labels_true[mask]
    lp = labels_pred[mask]
    ari = adjusted_rand_score(lt, lp)
    nmi = normalized_mutual_info_score(lt, lp)
    print(f"ARI: {ari:.3f}, NMI: {nmi:.3f}")


def visualize_embeddings(embed, labels, title="Embeddings"):
    embed_np = np.array(embed)
    if embed_np.shape[1] > 2:
        pca = PCA(n_components=2)
        emb2 = pca.fit_transform(embed_np)
    else:
        emb2 = embed_np

    plt.figure(figsize=(6, 5))
    sc = plt.scatter(emb2[:, 0], emb2[:, 1], c=labels, cmap="tab10", s=20)
    plt.colorbar(sc)
    plt.title(title)
    plt.tight_layout()
    plt.show()


def visualize_matrix_with_peaks(coinc, energy_axis_keV, peaks_idx):
    plt.figure(figsize=(6, 5))
    plt.imshow(coinc, origin="lower", cmap="inferno",
               extent=[energy_axis_keV[0], energy_axis_keV[-1],
                       energy_axis_keV[0], energy_axis_keV[-1]])
    plt.colorbar(label="Counts")
    plt.scatter(energy_axis_keV[peaks_idx], energy_axis_keV[peaks_idx],
                s=10, c="cyan", label="Peaks")
    plt.xlabel("Energy (keV)")
    plt.ylabel("Energy (keV)")
    plt.legend()
    plt.tight_layout()
    plt.show()


