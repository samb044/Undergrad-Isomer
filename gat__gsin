import os
import numpy as np
import pickle
import matplotlib.pyplot as plt
import scipy
from scipy.ndimage import label, center_of_mass
import torch
import torch.nn.functional as F
from torch_geometric.nn import GATConv
from collections import defaultdict, deque


# -----------------------------
# Utility: save/load matrices
# -----------------------------
def save_mat(data, file_name):
    with open(file_name, "wb") as f:
        pickle.dump(data, f)


def load_mat(file_name):
    with open(file_name, "rb") as f:
        return pickle.load(f)


# -----------------------------
# Simple Gaussian helpers
# -----------------------------
def gauss(x, mu, sigma):
    return (
        1.0
        / np.sqrt(2 * np.pi * sigma * sigma)
        * np.exp(-((x - mu) ** 2) / (2 * sigma * sigma))
    )


def gauss2d(x, xmu, xsigma, y, ymu, ysigma):
    return gauss(x, xmu, xsigma) * gauss(y, ymu, ysigma)


def convolve(input_arr, kernel):
    return scipy.signal.convolve(input_arr, kernel, mode="same")


# -----------------------------
# Toy level scheme + transitions
# -----------------------------
def create_new_transition_scheme(ev_levels):
    # ev_levels: list of level energies (in bin units)
    transition_scheme = []
    # each entry: (level_energy_bin, next_level_index, level_index)
    for i, level in enumerate(ev_levels):
        if i > 4 and np.random.rand() < 0.30:
            next_level = i - np.random.randint(2, i - 2)
            if next_level <= 0:
                next_level = 0
        else:
            next_level = i - 1
        transition_scheme.append((level, next_level, i))
    # ground state: no further transition
    transition_scheme[0] = (transition_scheme[0][0], -1, transition_scheme[0][2])
    return np.copy(transition_scheme)


def create_transition_mat_from_scheme(transition_scheme):
    # adjacency between levels (not γ energies yet)
    n = len(transition_scheme)
    transition_mat = np.zeros((n, n))
    for i, level in enumerate(transition_scheme):
        ev_level, next_idx, idx = level
        if next_idx == -1:
            continue
        transition_mat[i][next_idx] = 1
    return transition_mat


# -----------------------------
# Build coincidence matrix from cascades
# -----------------------------
def create_coinc_mat(num_gamma_rays, arr_size, transition_scheme, keV_per_bin):
    # coincidence matrix in bin space
    coinc_mat = np.zeros((arr_size, arr_size))

    # precompute level energies in keV
    level_energies_keV = []
    for level_energy_bin, next_idx, idx in transition_scheme:
        level_energies_keV.append(level_energy_bin * keV_per_bin)

    # build γ transitions: (from_level_idx, to_level_idx, gamma_energy_keV)
    gamma_list = []
    for i, (levE_bin, next_idx, idx) in enumerate(transition_scheme):
        if next_idx == -1:
            continue
        e_i = level_energies_keV[i]
        e_j = level_energies_keV[next_idx]
        gamma_E = e_i - e_j
        if gamma_E <= 0:
            continue
        gamma_list.append((i, next_idx, gamma_E))

    # map gamma energies to bin indices
    def gamma_energy_to_bin(E_keV):
        # simple linear mapping into [0, arr_size-1]
        return int(np.clip(E_keV / keV_per_bin, 0, arr_size - 1))

    # simulate cascades: each event follows a path down the scheme
    for _ in range(num_gamma_rays):
        # pick a random starting level (not ground)
        start = np.random.randint(1, len(transition_scheme))
        path = []
        cur = start
        while True:
            levE_bin, next_idx, idx = transition_scheme[cur]
            if next_idx == -1:
                break
            e_i = level_energies_keV[cur]
            e_j = level_energies_keV[next_idx]
            gamma_E = e_i - e_j
            if gamma_E <= 0:
                break
            g_bin = gamma_energy_to_bin(gamma_E)
            path.append(g_bin)
            cur = next_idx
        # fill coincidence matrix with all pairs in the path
        for i in range(len(path)):
            for j in range(i + 1, len(path)):
                x = path[i]
                y = path[j]
                coinc_mat[x, y] += 1
                coinc_mat[y, x] += 1

    return coinc_mat


# -----------------------------
# Create sample: levels, transitions, matrices
# -----------------------------
def create_sample(sim_size=0, draw_background=True):
    if sim_size == 0:
        arr_size = 2048
        num_levels = 12
        num_gamma_rays = 25000
    elif sim_size == 1:
        arr_size = 1024
        num_levels = 12
        num_gamma_rays = 1250000
    elif sim_size == 2:
        arr_size = 2048
        num_levels = 25
        num_gamma_rays = 2500000
    else:
        arr_size = 4096
        num_levels = 50
        num_gamma_rays = 2000000

    # simple keV calibration
    max_energy_keV = 3000.0
    keV_per_bin = max_energy_keV / arr_size
    energy_axis_keV = np.arange(arr_size) * keV_per_bin

    # random level energies in bin units
    ev_levels = [0]
    for _ in range(num_levels):
        e_bin = min(int(np.random.rayleigh(arr_size / 3 + 20)), arr_size - 20)
        while e_bin in ev_levels:
            e_bin = min(int(np.random.rayleigh(arr_size / 3 + 20)), arr_size - 20)
        ev_levels.append(e_bin)

    transition_scheme = create_new_transition_scheme(np.copy(ev_levels))
    transition_mat = create_transition_mat_from_scheme(transition_scheme.copy())

    coinc_mat = create_coinc_mat(
        num_gamma_rays, arr_size, transition_scheme.copy(), keV_per_bin
    )

    # blur with Gaussian kernel to mimic detector response
    gb_size = 5
    gb = np.zeros((gb_size, gb_size))
    for i in range(gb_size):
        for j in range(gb_size):
            gb[i][j] = gauss2d(
                2 * (i - gb_size / 2) / gb_size,
                0,
                0.5,
                2 * (j - gb_size / 2) / gb_size,
                0,
                0.5,
            )
    coinc_mat = convolve(coinc_mat, gb)

    return coinc_mat, transition_mat, energy_axis_keV


# -----------------------------
# Peak finding + graph building
# -----------------------------
def find_threshold(chunk, t):
    bg = np.median(chunk)
    return bg + (t * np.sqrt(bg + 1))


def coincide(g1, g2, d):
    return (g2 in d.get(g1, set())) or (g1 in d.get(g2, set()))


def build_graph_from_matrix(coinc_mat, energy_axis_keV, t_factor=30):
    mat_size = coinc_mat.shape[0]
    chunk_size = 128
    peaks = np.zeros(coinc_mat.shape, dtype=bool)

    # thresholding
    for i in range(0, mat_size, chunk_size):
        for j in range(0, mat_size, chunk_size):
            chunk = coinc_mat[i:i+chunk_size, j:j+chunk_size]
            threshold = find_threshold(chunk, t_factor)
            peaks[i:i+chunk_size, j:j+chunk_size] = chunk > threshold

    # label regions
    grouped_peaks, num_regions = label(peaks)

    # centroids
    actual_peaks = center_of_mass(
        coinc_mat,
        grouped_peaks,
        range(1, num_regions + 1)
    )

    tran_in_coinc = defaultdict(set)
    intensity_dict = defaultdict(float)

    for y1, y2 in actual_peaks:
        i = int(round(y1))
        j = int(round(y2))
        energy1 = float(energy_axis_keV[i])
        energy2 = float(energy_axis_keV[j])

        tran_in_coinc[energy1].add(energy2)
        tran_in_coinc[energy2].add(energy1)

        intensity_dict[energy1] += coinc_mat[i, j]
        intensity_dict[energy2] += coinc_mat[i, j]

    # build node list
    tot_trans = set(tran_in_coinc.keys())
    for t, coincs in tran_in_coinc.items():
        tot_trans |= coincs
    sorted_transitions = sorted(tot_trans)

    energy_index = {E: idx for idx, E in enumerate(sorted_transitions)}
    index_energy = {idx: E for E, idx in energy_index.items()}

    # edges
    edges = []
    for t, coincs in tran_in_coinc.items():
        for t2 in coincs:
            edges.append((energy_index[t], energy_index[t2]))
    edge_index = torch.tensor(edges, dtype=torch.long).T

    # node features: [energy_keV, degree, intensity]
    node_feat = []
    for E in sorted_transitions:
        degree = len(tran_in_coinc.get(E, set()))
        intensity = intensity_dict.get(E, 0.0)
        node_feat.append([E, degree, intensity])
    features_node = torch.tensor(node_feat, dtype=torch.float)
    for col in range(features_node.shape[1]):
        max_val = features_node[:, col].max()
        if max_val > 0:
            features_node[:, col] /= max_val

    return tran_in_coinc, intensity_dict, energy_index, index_energy, edge_index, features_node


# -----------------------------
# Band labels from connected components
# -----------------------------
def build_band_labels_from_graph(tran_in_coinc, energy_index):
    # bands = connected components in coincidence graph
    # this gives some isolated nodes and some connected groups
    visited = set()
    bands = []
    for E in energy_index.keys():
        if E in visited:
            continue
        comp = []
        queue = deque([E])
        visited.add(E)
        while queue:
            cur = queue.popleft()
            comp.append(cur)
            for nb in tran_in_coinc.get(cur, []):
                if nb not in visited:
                    visited.add(nb)
                    queue.append(nb)
        bands.append(comp)

    # assign band IDs
    band_id_map = {}
    for b_idx, comp in enumerate(bands):
        for E in comp:
            band_id_map[E] = b_idx

    # build label vector
    sorted_transitions = sorted(energy_index.keys())
    labels = []
    for E in sorted_transitions:
        labels.append(band_id_map.get(E, -1))
    return torch.tensor(labels, dtype=torch.long)


# -----------------------------
# GAT model
# -----------------------------
class Band_Predicting_GAT(torch.nn.Module):
    def __init__(self, inputs, hidden, out_dim):
        super().__init__()
        self.gat1 = GATConv(inputs, hidden, heads=2)
        self.gat2 = GATConv(hidden * 2, out_dim, heads=1)

    def forward(self, x, edge_index):
        x = F.elu(self.gat1(x, edge_index))
        return self.gat2(x, edge_index)


# -----------------------------
# Training pipeline
# -----------------------------
def train_on_sample(coinc_mat, energy_axis_keV, epochs=300):
    tran_in_coinc, intensity_dict, energy_index, index_energy, edge_index, features_node = \
        build_graph_from_matrix(coinc_mat, energy_axis_keV)

    labels = build_band_labels_from_graph(tran_in_coinc, energy_index)

    # build training pairs: same-band vs different-band
    poss = []
    tar = []
    num_nodes = labels.shape[0]
    for i in range(num_nodes):
        for j in range(i + 1, num_nodes):
            li = labels[i].item()
            lj = labels[j].item()
            if li == -1 or lj == -1:
                continue
            poss.append([i, j])
            tar.append(1.0 if li == lj else 0.0)

    if len(poss) == 0:
        print("No labeled pairs; skipping training.")
        return features_node, edge_index, labels, energy_index, index_energy

    possibilities = torch.tensor(poss, dtype=torch.long)
    targets = torch.tensor(tar, dtype=torch.float)

    model = Band_Predicting_GAT(inputs=features_node.shape[1], hidden=16, out_dim=8)
    optimizer = torch.optim.Adam(model.parameters(), lr=0.01, weight_decay=1e-4)

    for epoch in range(epochs):
        model.train()
        optimizer.zero_grad()
        z = model(features_node, edge_index)
        first = possibilities[:, 0]
        second = possibilities[:, 1]
        sim_score = (z[first] * z[second]).sum(dim=1)
        loss = F.binary_cross_entropy_with_logits(sim_score, targets)
        loss.backward()
        optimizer.step()
        if epoch % 50 == 0:
            print(f"Epoch {epoch} | Loss {loss.item():.4f}")

    model.eval()
    with torch.no_grad():
        embed = model(features_node, edge_index)
        normalized = embed / embed.norm(dim=1, keepdim=True)
        grouping_chances = normalized @ normalized.T

    # group nodes by similarity
    grouping_threshold = 0.75
    min_size = 2
    possible_bands = []
    num_nodes = embed.shape[0]
    for i in range(num_nodes):
        band = [j for j in range(num_nodes)
                if grouping_chances[i, j] >= grouping_threshold]
        if len(band) >= min_size:
            possible_bands.append(band)

    seen = set()
    unique_groups = []
    for band in possible_bands:
        key = frozenset(band)
        if key not in seen:
            seen.add(key)
            unique_groups.append(band)

    print("\nPredicted bands (from embeddings):")
    for bnum, band in enumerate(unique_groups):
        energies = [float(index_energy[node]) for node in band]
        print(f"Band {bnum+1}: {sorted(energies)}")

    return features_node, edge_index, labels, energy_index, index_energy


# -----------------------------
# Main: generate, train, print
# -----------------------------
def main():
    coinc_mat, transition_mat, energy_axis_keV = create_sample(sim_size=0, draw_background=True)
    save_mat(coinc_mat, "yy_coincidence_matrix.mat")
    save_mat(transition_mat, "transition_matrix.mat")
    save_mat(energy_axis_keV, "energy_axis_keV.mat")

    train_on_sample(coinc_mat, energy_axis_keV, epochs=300)


if __name__ == "__main__":
    main()




