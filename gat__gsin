# 9. FULL SUPERVISED PIPELINE
# =========================

def run_full_pipeline_supervised():
    bands = generate_bands_cascade(num_bands=8, max_gamma_keV=1500.0)

    coinc, energy_axis_keV = bands_to_coincidence_matrix_cascade(
        bands,
        arr_size=512,
        keV_max=3000.0,
        num_events=5000,
        noise_level=0.02
    )

    peaks_mask, intensity, energy_index, index_energy, edges, features_node, energy_list, edge_weights = \
        build_graph_from_matrix_optimized(
            coinc,
            energy_axis_keV,
            bands=bands,
            delta_E=50.0
        )

    labels = build_true_labels(index_energy, bands, atol=20.0)

    print("Unique labels:", np.unique(labels))
    print("Label counts (excluding -1):", np.bincount(labels[labels >= 0]))

    index_energy_l, features_node_l, edges_l, edge_w_l, labels_l = \
        build_band_focused_graph(
            index_energy,
            features_node,
            edges,
            edge_weights,
            labels,
            max_band_keV=1600.0
        )

    params_gat, params_cls, embed, logits = train_gat_seven_layer_labeled(
        features_node_l,
        edges_l,
        labels_l,
        index_energy_l,
        edge_w_l,
        epochs=320
    )

    predicted_l = cluster_embeddings(embed, index_energy_l)

    evaluate_band_reconstruction(labels_l, predicted_l)

    visualize_embeddings(embed, predicted_l, title="Predicted clusters (labeled-only)")
    visualize_embeddings(embed, labels_l, title="True bands (labeled-only)")
    visualize_matrix_with_peaks(coinc, energy_axis_keV, peaks_mask)

    return (
        bands,
        predicted_l,
        index_energy_l,
        features_node_l,
        edges_l,
        params_gat,
        params_cls
    )


if __name__ == "__main__":
